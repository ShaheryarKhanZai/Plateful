# Copy this file to ".env" and fill in your own values. Never commit ".env".
# Every value below is a placeholder.

ENVIRONMENT=development

# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# If your password has special characters (@ : / # %), URL-encode them.
DATABASE_URL=postgresql+psycopg://fooddelivery_app:YOUR_DB_PASSWORD@localhost:5432/fooddelivery

# Used only by the tests. Must be a SEPARATE database: tests wipe its tables.
TEST_DATABASE_URL=postgresql+psycopg://fooddelivery_app:YOUR_DB_PASSWORD@localhost:5432/fooddelivery_test

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start if this is short or still starts with "change-me".
JWT_SECRET=change-me-generate-your-own-long-random-value
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# The ONLY browser origin allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:5173

# false is fine on http://localhost. MUST be true behind HTTPS in production.
COOKIE_SECURE=false

RATE_LIMIT_ENABLED=true

# Only used by scripts/seed.py. Pick your own value (10+ characters).
# The seed script refuses to run with this placeholder.
SEED_USER_PASSWORD=change-me-pick-a-seed-password
